# Place this exact location inside the same server block that serves dist/.
# Do not enable request-header or request-body logging for this route.
location = /api/ark-agent-plan/v3/responses {
    proxy_pass https://ark.cn-beijing.volces.com/api/plan/v3/responses;
    proxy_ssl_server_name on;
    proxy_ssl_name ark.cn-beijing.volces.com;
    proxy_set_header Host ark.cn-beijing.volces.com;

    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type $content_type;
    proxy_set_header Accept $http_accept;

    proxy_connect_timeout 15s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;
    proxy_buffering off;
}
